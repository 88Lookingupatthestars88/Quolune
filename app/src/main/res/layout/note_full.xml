<?xml version="1.0" encoding="utf-8"?>
<!--
    展开态：句子放到三行，按键和念速各占一排。
    上半截跟收起态完全一致，只是句子更长、底下多一排念速，展开前后不会跳。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nf_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/nf_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nf_ch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/nf_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/nf_prev"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/note_btn"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/note_prev"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/nf_toggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/note_btn_strong"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/note_pause"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/nf_next"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/note_btn"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/note_next"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/nf_close"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/note_btn"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/note_quit"
            android:textSize="12.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/nf_r1"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/note_rate_off"
            android:gravity="center"
            android:text="0.75×"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/nf_r2"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/note_rate_off"
            android:gravity="center"
            android:text="1.0×"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/nf_r3"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/note_rate_off"
            android:gravity="center"
            android:text="1.25×"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/nf_r4"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/note_rate_off"
            android:gravity="center"
            android:text="1.5×"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/nf_r5"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/note_rate_off"
            android:gravity="center"
            android:text="2.0×"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
